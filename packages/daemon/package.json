{
  "name": "@attentio/daemon",
  "version": "0.1.0",
  "description": "Attentio collector daemon: platform sensors, SQLite storage, REST/SSE API and the analytics engine.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
