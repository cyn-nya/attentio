{
  "name": "@attentio/shared",
  "version": "0.1.0",
  "description": "Shared domain types and pure logic for Attentio (categories, focus scoring, sessionization).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "attentio",
    "focus",
    "productivity",
    "time-tracking"
  ],
  "engines": {
    "node": ">=22.6.0"
  }
}
