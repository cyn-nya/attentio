{
  "name": "attentio-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first attention & productivity intelligence for desktop and phone.",
  "license": "MIT",
  "engines": {
    "node": ">=22.6.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "npm run dev",
    "dev": "node --conditions=development packages/cli/src/index.ts start",
    "doctor": "node --conditions=development packages/cli/src/index.ts doctor",
    "today": "node --conditions=development packages/cli/src/index.ts today",
    "report": "node --conditions=development packages/cli/src/index.ts report",
    "why": "node --conditions=development packages/cli/src/index.ts why",
    "attentio": "node --conditions=development packages/cli/src/index.ts",
    "web": "npm run dev --workspace apps/web",
    "web:build": "npm run build --workspace apps/web",
    "build": "tsc -b packages/shared packages/daemon packages/cli && npm run web:build",
    "build:node": "tsc -b packages/shared packages/daemon packages/cli",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p apps/web/tsconfig.json",
    "test": "node --test --test-timeout=180000 \"packages/*/test/*.test.ts\"",
    "test:web": "npm run smoke --workspace apps/web",
    "test:collector": "node --conditions=development --disable-warning=ExperimentalWarning tools/collector-check.ts",
    "test:live": "node --test --test-timeout=180000 \"packages/daemon/test/collector.test.ts\"",
    "test:all": "npm test && npm run test:web",
    "verify": "npm run typecheck && npm run test:all && npm run build",
    "clean": "node scripts/clean.mjs",
    "prepare": "npm run build",
    "pretest": "tsc -b packages/shared"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
